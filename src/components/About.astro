---
import { siteConfig } from '../data/site';
---

<section id="about" class="about" aria-labelledby="about-heading">
  <div class="container about-inner">
    <div class="about-content">
      <h2 id="about-heading" class="section-title">{siteConfig.about.headline}</h2>
      
      <p class="about-text">{siteConfig.about.text}</p>
      
      <dl class="about-stats">
        {siteConfig.about.stats.map(stat => (
          <div class="stat-item">
            <dt class="stat-number">{stat.number}</dt>
            <dd class="stat-label">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
.about {
  background-color: var(--color-surface);
}

.about-inner {
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

.about-text {
  font-size: var(--text-md);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xl);
}

.about-stats {
  display: grid;
  gap: var(--space-lg);
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
}

.stat-item dt,
.stat-item dd {
  margin: 0;
}

.stat-number {
  font-family: var(--font-serif);
  font-size: var(--text-3xl);
  font-weight: bold;
  color: var(--color-accent);
  line-height: 1.2;
}

.stat-label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}
</style>

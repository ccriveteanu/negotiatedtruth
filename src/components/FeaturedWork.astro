---
import { siteConfig } from '../data/site';
---

<section id="work" class="featured-work" aria-labelledby="work-heading">
  <div class="container">
    <h2 id="work-heading" class="section-title">Featured Work</h2>
    
    <div class="work-grid">
      {siteConfig.work.map((item, index) => (
        <article 
          class="work-card"
          aria-label={`Project: ${item.title}`}
        >
          <div class="work-badge">{item.category}</div>
          <h3 class="work-title">{item.title}</h3>
          <p class="work-description">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.featured-work {
  background-color: var(--color-background);
}

.work-grid {
  display: grid;
  gap: var(--space-lg);
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

.work-card {
  padding: var(--space-lg);
  border-radius: var(--border-radius);
  background-color: var(--color-surface);
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.work-card:hover,
.work-card:focus-within {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(65, 73, 85, 0.1);
}

.work-badge {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-accent);
  padding: var(--space-xs) var(--space-sm);
  background-color: var(--color-accent-subtle);
  border-radius: 2px;
  margin-bottom: var(--space-md);
}

.work-title {
  font-size: var(--text-lg);
  margin-bottom: var(--space-sm);
}

.work-description {
  color: var(--color-text-secondary);
}
</style>

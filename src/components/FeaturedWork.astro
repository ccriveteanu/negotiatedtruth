---
import { siteConfig } from '../data/site';
---

<section id="work" class="featured-work py-24" aria-labelledby="work-heading">
  <div class="container">
    <h2 id="work-heading" class="section-title text-center">Featured Work</h2>

    <div class="grid gap-8 md:grid-cols-3 mt-16">
      {siteConfig.work.map((item, index) => (
        <article
          key={index}
          class="work-card card-glow-light rounded-3xl overflow-hidden bg-[#0a0518]"
          aria-label={`Project: ${item.title}`}
        >
          <div class="p-8">
            <span class="work-badge inline-block px-4 py-2 text-xs font-semibold uppercase tracking-wider text-primary mb-6 rounded-full border border-primary/30 bg-primary/10">
              {item.category}
            </span>
            <h3 class="work-title text-xl font-bold mb-4">{item.title}</h3>
            <p class="work-description text-gray-400 leading-relaxed">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .featured-work {
    background: radial-gradient(circle at center, #120a22 0%, #0a0518 100%);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 3rem;
    text-align: center;
    color: white;
  }

  .work-card {
    transition: transform 300ms ease, box-shadow 300ms ease;
  }

  .work-card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 0 40px var(--secondary),
      inset 0 0 20px rgba(80, 22, 138, 0.1);
  }

  .work-badge {
    color: #7c2d9b;
    border-color: rgba(124, 45, 155, 0.3);
    background-color: rgba(124, 45, 155, 0.1);
  }

  .work-title {
    color: white;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
</style>

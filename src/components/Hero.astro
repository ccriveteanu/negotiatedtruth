---
import { siteConfig } from '../data/site';

// Generate star positions for background animation
function generateStars(count: number, spread = 3000): string {
  return Array.from({ length: count }, () => {
    const x = Math.floor(Math.random() * spread);
    const y = Math.floor(Math.random() * spread);
    const opacity = (0.4 + Math.random() * 0.6).toFixed(2);
    return `${x}px ${y}px rgba(255,255,255,${opacity})`;
  }).join(",");
}

const stars1 = generateStars(160); // 1 px - many
const stars2 = generateStars(60);  // 2 px - medium
const stars3 = generateStars(22);  // 3 px - few bright
---

<section class="hero relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden px-6 pt-32 pb-24" style={`--stars1:${stars1};--stars2:${stars2};--stars3:${stars3};`}>
  {/* Animated galaxy background */}
  <div class="galaxy-bg pointer-events-none">
    <div class="nebula"></div>
    <div class="s1 absolute inset-0"></div>
    <div class="s2 absolute inset-0"></div>
    <div class="s3 absolute inset-0"></div>
  </div>

  {/* Hero content */}
  <div class="relative z-10 flex w-full max-w-4xl flex-col items-center gap-6 text-center">
    <h1 class="hero-title">{siteConfig.hero.title}</h1>
    <p class="hero-subline">{siteConfig.hero.subtitle}</p>

    <div class="flex flex-col gap-6 mt-8">
      <a href={siteConfig.hero.ctaLink} class="btn-primary inline-flex items-center justify-center">
        {siteConfig.hero.ctaText}
      </a>
      <a href="#about" class="group inline-flex cursor-pointer items-center gap-2 rounded border-2 border-white/30 bg-white/5 px-6 py-3 text-base font-semibold whitespace-nowrap text-white/80 no-underline transition-all hover:border-white hover:text-white">
        <span>Learn More</span>
        <svg class="h-4 w-4 transition-all duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

    {/* References marquee */}
    <div class="mt-16 flex flex-wrap justify-center gap-8 opacity-70 transition-all duration-500 hover:opacity-100">
      {['Strategic', 'Resolution', 'Communication'].map((word, i) => (
        <span key={i} class="text-lg font-semibold tracking-widest text-white/60 uppercase">
          {word}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Hero container with dark gradient */
  .hero {
    background: radial-gradient(ellipse at 50% 40%, #16003e 0%, #040010 55%, #000 100%);
  }

  /* Star layers */
  .s1::before, .s2::before, .s3::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    background-color: transparent;
  }

  .s1::before { width: 1px; height: 1px; box-shadow: var(--stars1); animation: twinkle 10s ease-in-out infinite alternate; }
  .s2::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background-color: transparent;
    box-shadow: var(--stars2);
    animation: twinkle 14s ease-in-out infinite alternate;
  }
  .s3::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: transparent;
    box-shadow: var(--stars3);
    animation: twinkle 18s ease-in-out infinite alternate;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Re-generate stars on page load for dynamic effect
    const hero = document.querySelector('.hero');
    if (hero) {
      hero.style.setProperty('--stars1', generateStars(160));
      hero.style.setProperty('--stars2', generateStars(60));
      hero.style.setProperty('--stars3', generateStars(22));
    }
  });
</script>

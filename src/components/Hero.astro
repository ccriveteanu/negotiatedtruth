---
import { siteConfig } from '../data/site';

// Generate star positions for background animation
function generateStars(count: number, spread = 3000): string {
  return Array.from({ length: count }, () => {
    const x = Math.floor(Math.random() * spread);
    const y = Math.floor(Math.random() * spread);
    const opacity = (0.4 + Math.random() * 0.6).toFixed(2);
    return `${x}px ${y}px rgba(255,255,255,${opacity})`;
  }).join(",");
}

const stars1 = generateStars(160); // 1 px - many
const stars2 = generateStars(60, 3000);  // 2 px - medium
const stars3 = generateStars(22, 4000);  // 3 px - few bright
---

<section class="hero relative flex min-h-screen w-full flex-col items-center justify-center overflow-hidden px-6 pt-32 pb-24" style={`--stars1:${stars1};--stars2:${stars2};--stars3:${stars3};`}>
  {/* Animated galaxy background */}
  <div class="galaxy-bg pointer-events-none">
    <div class="nebula"></div>
    <div class="s1 absolute inset-0"></div>
    <div class="s2 absolute inset-0"></div>
    <div class="s3 absolute inset-0"></div>
  </div>

  {/* Hero content */}
  <div class="relative z-10 flex w-full max-w-4xl flex-col items-center gap-6 text-center">
    <h1 class="hero-title">{siteConfig.hero.title}</h1>
    <p class="hero-subtitle">{siteConfig.hero.subtitle}</p>

    <div class="flex flex-col gap-6 mt-8">
      <a href={siteConfig.hero.ctaLink} class="btn-primary inline-flex items-center justify-center">
        {siteConfig.hero.ctaText}
      </a>
    </div>

    {/* References marquee (simplified) */}
    <div class="mt-12 flex flex-wrap gap-8 opacity-70 grayscale transition-all duration-500 hover:grayscale-0">
      {[1, 2, 3].map(i => (
        <span key={i} class="text-lg font-semibold tracking-widest text-gray-400 uppercase">
          Partner {i}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
/* Hero container with dark gradient */
.hero {
  background: radial-gradient(ellipse at 50% 40%, #16003e 0%, #040010 55%, #000 100%);
}

/* Rotating galaxy container */
.galaxy-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  height: 3000px;
  width: 3000px;
  transform-origin: center;
  animation: galaxyRotate 150s linear infinite;
}

@keyframes galaxyRotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

/* Nebula blobs */
.nebula {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 55% 38% at 28% 38%, rgba(80, 22, 138, 0.65) 0%, transparent 65%), 
              radial-gradient(ellipse 38% 28% at 72% 62%, rgba(242, 100, 48, 0.28) 0%, transparent 65%),
              radial-gradient(ellipse 48% 52% at 62% 22%, rgba(80, 22, 138, 0.4) 0%, transparent 60%),
              radial-gradient(ellipse 65% 42% at 42% 82%, rgba(20, 0, 50, 0.85) 0%, transparent 70%);
  animation: nebulaPulse 24s ease-in-out infinite alternate;
}

@keyframes nebulaPulse {
  0% { opacity: 0.72; }
  100% { opacity: 1; }
}

/* Star layers */
.s1::before, .s2::before, .s3::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  border-radius: 50%;
  background-color: transparent;
}

.s1::before { box-shadow: var(--stars1); animation: twinkle 10s ease-in-out infinite alternate; }
.s2::before { 
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 2px;
  height: 2px;
  border-radius: 50%;
  background-color: transparent;
  box-shadow: var(--stars2);
  animation: twinkle 14s ease-in-out infinite alternate;
}
.s3::before { 
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background-color: transparent;
  box-shadow: var(--stars3);
  animation: twinkle 18s ease-in-out infinite alternate;
}

@keyframes twinkle {
  0% { opacity: 0.6; }
  100% { opacity: 1; }
}

/* Title styles */
.hero-title {
  margin: 0;
  font-size: clamp(2.4rem, 6vw, 4.8rem);
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -0.025em;
  color: white;
}

.hero-subtitle {
  font-size: clamp(1.125rem, 2vw, 1.5rem);
  color: #a0a0a0;
  max-width: 640px;
}
</style>

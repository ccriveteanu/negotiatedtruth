---
import { siteConfig } from '../data/site';
---

<footer class="footer border-t border-gray-800 bg-[#0a0518]" role="contentinfo">
  <div class="container footer-inner py-16">
    <div class="grid gap-12 md:grid-cols-4">
      <div class="footer-brand md:col-span-2">
        <a href="/" class="text-2xl font-bold tracking-tight">{siteConfig.title}</a>
        <p class="footer-description mt-4 text-gray-400 max-w-md leading-relaxed">
          {siteConfig.description}
        </p>
      </div>
      
      <div class="footer-links">
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-6 text-white">Navigation</h3>
        <ul class="space-y-3">
          {siteConfig.navLinks.map(link => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-primary transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="footer-social">
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-6 text-white">Connect</h3>
        <ul class="space-y-3">
          {siteConfig.footer.socialLinks.map(link => (
            <li>
              <a 
                href={link.href} 
                class="text-gray-400 hover:text-primary transition-colors flex items-center gap-2"
              >
                <span aria-hidden="true">↗</span> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  
  <div class="container footer-bottom border-t border-gray-800 py-6 text-center">
    <p>&copy; {new Date().getFullYear()} {siteConfig.title}. All rights reserved.</p>
  </div>
</footer>

<style>
.footer-inner {
  display: grid;
  gap: 2rem;
}

.footer-description {
  font-size: 1.125rem;
  line-height: 1.8;
}

.footer-bottom p {
  font-size: 0.875rem;
  color: #6b7280;
}
</style>

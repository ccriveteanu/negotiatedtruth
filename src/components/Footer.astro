---
import { siteConfig } from '../data/site';
---

<footer class="footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo">{siteConfig.title}</a>
      <p class="footer-description">{siteConfig.description}</p>
    </div>
    
    <div class="footer-links">
      {siteConfig.navLinks.map(link => (
        <a href={link.href} class="footer-link">{link.label}</a>
      ))}
    </div>
    
    <div class="footer-social">
      {siteConfig.footer.socialLinks.map(link => (
        <a 
          href={link.href} 
          class="social-link"
          aria-label={link.label}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
  
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {siteConfig.title}. All rights reserved.</p>
  </div>
</footer>

<style>
.footer {
  background-color: var(--color-surface);
  border-top: 1px solid var(--color-accent-subtle);
}

.footer-inner {
  display: grid;
  gap: var(--space-lg);
  padding-top: var(--space-xl);
  padding-bottom: var(--space-md);
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

.footer-brand .logo {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: bold;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--space-sm);
}

.footer-description {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}

.footer-links,
.footer-social {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.footer-link,
.social-link {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  text-decoration: none;
}

.footer-link:hover,
.social-link:hover {
  color: var(--color-accent);
  text-decoration: underline;
}

.footer-bottom {
  padding-top: var(--space-md);
  padding-bottom: var(--space-md);
  border-top: 1px solid var(--color-accent-subtle);
  text-align: center;
}

.footer-bottom p {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-bottom: 0;
}

@media (max-width: 768px) {
  .footer-inner {
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
}
</style>

---
import Logo from '../brand/Logo.astro';
import { href } from '../../lib/content';
const path = Astro.url.pathname;
const links = [
  { label: 'Writing', path: 'writing/' },
  { label: 'About', path: 'about/' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={href()} aria-label="NegotiatedTruth home">
      <Logo />
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={href(link.path)}
          aria-current={path.startsWith(href(link.path)) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href={href('rss.xml')} class="rss-link" aria-label="Follow via RSS">
        RSS <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

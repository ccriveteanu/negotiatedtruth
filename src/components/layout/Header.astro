---
import Logo from '../brand/Logo.astro';
import { href } from '../../lib/content';
const path = Astro.url.pathname;
const links = [
  { label: 'Writing', path: 'writing/' },
  { label: 'Topics', path: 'topics/' },
  { label: 'About', path: 'about/' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={href()} aria-label="NegotiatedTruth home">
      <Logo />
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={href(link.path)}
          aria-current={path.startsWith(href(link.path)) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a class="rss-link" href={href('rss.xml')}>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="4" cy="16" r="1.4" fill="currentColor" />
          <path
            d="M3 9a8 8 0 0 1 8 8M3 3a14 14 0 0 1 14 14"
            stroke="currentColor"
            stroke-width="1.6"
          />
        </svg>
        <span>RSS</span>
      </a>
    </nav>
  </div>
</header>

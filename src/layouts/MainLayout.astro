---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { href } from '../lib/content';
import { siteConfig } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: { published: string; updated?: string };
}
const {
  title,
  description = siteConfig.description,
  noindex = false,
  article,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${siteConfig.title}`
  : `${siteConfig.title} — Strategy, technology & AI`;
const canonical = new URL(Astro.url.pathname, Astro.site!);
const image = new URL(href('brand/social.png'), Astro.site!);
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: article.published,
      dateModified: article.updated || article.published,
      author: {
        '@type': 'Person',
        name: siteConfig.author,
        url: new URL(href('about/'), Astro.site!).href,
      },
      mainEntityOfPage: canonical.href,
      image: image.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      url: Astro.site!.href,
      description,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbf7" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="NegotiatedTruth"
      href={href('rss.xml')}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="NegotiatedTruth. Essays, notes and visual stories by Cătălin Criveteanu."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {article && (
      <meta property="article:published_time" content={article.published} />
    )}
    {article?.updated && (
      <meta property="article:modified_time" content={article.updated} />
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

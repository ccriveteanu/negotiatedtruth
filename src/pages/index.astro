---
import MainLayout from '../layouts/MainLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, href, formatDate, openingParagraphs } from '../lib/content';
import { siteConfig } from '../data/site';
const posts = await getPosts();
const [latest, ...rest] = posts;
---

<MainLayout>
  <div class="shell home-journal">
    <section class="personal-intro" aria-label="A short introduction">
      <h1 class="sr-only">
        NegotiatedTruth — a personal journal by {siteConfig.author}
      </h1>
      <p>
        I'm <a href={href('about/')}>Cătălin</a>. I write about strategy,
        technology and AI, and the decisions that connect them.
      </p>
      <span class="intro-caption">
        A personal journal. Always a work in progress.
      </span>
    </section>
    {latest && (
      <article class="lead-entry">
        <div class="entry-meta">
          <time datetime={latest.data.publishedAt.toISOString()}>
            {formatDate(latest.data.publishedAt)}
          </time>
          <span class="meta-divider">/</span>
          <span>{latest.data.type}</span>
          {latest.data.sample && <span class="sample-tag">Sample writing</span>}
        </div>
        <h2>
          <a href={href(`writing/${latest.id}/`)}>{latest.data.title}</a>
        </h2>
        <div class="lead-opening">
          {openingParagraphs(latest).map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <a class="continue-link" href={href(`writing/${latest.id}/`)}>
          Continue reading <span aria-hidden="true">↗</span>
          <span class="sr-only">: {latest.data.title}</span>
        </a>
      </article>
    )}
    <section class="recent-writing" aria-labelledby="recent-heading">
      <div class="section-heading">
        <h2 id="recent-heading">More from the journal</h2>
        <a href={href('writing/')}>All writing ↗</a>
      </div>
      {rest.map((post) => (
        <PostRow post={post} />
      ))}
      {rest.length === 0 && <p class="muted">More writing is on the way.</p>}
    </section>
  </div>
</MainLayout>

---
import MainLayout from '../../layouts/MainLayout.astro';
import { topics } from '../../data/site';
import { href, getPosts } from '../../lib/content';
const posts = await getPosts();
---

<MainLayout
  title="Topics"
  description="Explore the journal through three connected lenses: strategy, technology and AI."
>
  <section class="shell page-intro">
    <span class="eyebrow">Connected thinking</span>
    <h1>Topics.</h1>
    <p>Three connected subjects. Follow a thread through the writing.</p>
  </section>
  <section class="shell topic-directory">
    {topics.map((t) => (
      <a class="topic-directory-row" href={href(`topics/${t.id}/`)}>
        <span class="topic-number">/{t.number}</span>
        <div>
          <h2>
            {t.name} <span aria-hidden="true">↗</span>
          </h2>
          <p>{t.description}</p>
        </div>
        <span class="topic-count">
          {posts.filter((p) => p.data.topic === t.id).length}{' '}
          {posts.filter((p) => p.data.topic === t.id).length === 1
            ? 'piece'
            : 'pieces'}
        </span>
      </a>
    ))}
  </section>
</MainLayout>

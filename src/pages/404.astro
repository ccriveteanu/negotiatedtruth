---
import MainLayout from '../layouts/MainLayout.astro';

const title = "Page Not Found - Negotiated Truth";
---

<MainLayout 
  title={title} 
  description="The page you are looking for does not exist."
>
  <section class="min-h-screen flex items-center justify-center px-4 py-24">
    <div class="container text-center max-w-lg">
      <h1 class="text-9xl font-bold mb-8">404</h1>
      <p class="text-2xl font-medium mb-6">Page Not Found</p>
      <p class="text-gray-400 mb-12">
        The page you are looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn-primary inline-flex items-center justify-center px-8 py-4 text-lg rounded-xl">
        Go Home
      </a>
    </div>
  </section>
</MainLayout>

<style>
.min-h-screen {
  min-height: 100vh;
}
</style>
